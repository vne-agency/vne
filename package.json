{
  "name": "elda-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "pnpm generate:types && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "postbuild": "node --import tsx scripts/prepare-standalone.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test:unit && pnpm build",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:status": "docker compose ps postgres",
    "db:migrate": "payload migrate",
    "db:migrate:status": "payload migrate:status",
    "infra:check": "cross-env TELEGRAM_NOTIFICATIONS_DISABLED=true node --env-file-if-exists=.env --import tsx scripts/check-infrastructure.ts",
    "telegram:discover": "node --env-file-if-exists=.env --import tsx scripts/discover-telegram-chats.ts",
    "telegram:check": "node --env-file-if-exists=.env --import tsx scripts/check-telegram.ts",
    "telegram:test": "node --env-file-if-exists=.env --import tsx scripts/check-telegram.ts --send-test",
    "telegram:webhook": "node --env-file-if-exists=.env --import tsx scripts/configure-telegram-webhook.ts",
    "seed:cases": "node --env-file-if-exists=.env --import tsx scripts/seed-cases.ts",
    "seed:case-details": "node --env-file-if-exists=.env --import tsx scripts/seed-case-details.ts",
    "preview:public-proxy": "node scripts/public-preview-proxy.mjs",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.0",
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "graphql": "^16.11.0",
    "lenis": "1.3.26",
    "motion": "12.43.0",
    "next": "16.3.5",
    "payload": "3.87.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "tsx": "^4.22.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
